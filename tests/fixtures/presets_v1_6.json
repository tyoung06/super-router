{
  "version": "1.6",
  "presets": {
    "research-build": {
      "description": "One agent researches the web and X, a second builds from what it found, and a third checks the result.",
      "stages": [
        {"n": 1, "agent": "grok",   "role": "research", "contract": "research_note"},
        {"n": 2, "agent": "claude", "role": "build",    "contract": null}
      ],
      "checker": "chatgpt",
      "slots": {"research": [1], "build": [2], "check": ["checker"]}
    },
    "collab": {
      "description": "Two agents work as a pair: one plans, the other improves the plan, the first does the work, and the second edits and checks it.",
      "stages": [
        {"n": 1, "agent": "claude",  "role": "plan",    "contract": "plan"},
        {"n": 2, "agent": "chatgpt", "role": "amend",   "contract": "amended_plan"},
        {"n": 3, "agent": "claude",  "role": "execute", "contract": "deliverable"},
        {"n": 4, "agent": "chatgpt", "role": "edit",    "contract": "edit_check", "is_check": true}
      ],
      "checker": null,
      "slots": {"lead": [1, 3], "partner": [2, 4]}
    },
    "versus": {
      "description": "Two agents each build their own answer from the task alone and review each other's, then you pick the winner.",
      "stages": [
        {"n": 1, "agent": "claude",  "role": "build",  "input": "task",    "contract": null},
        {"n": 2, "agent": "chatgpt", "role": "build",  "input": "task",    "contract": null},
        {"n": 3, "agent": "chatgpt", "role": "review", "input": "stage:1", "review_of": 1, "contract": "review_note"},
        {"n": 4, "agent": "claude",  "role": "review", "input": "stage:2", "review_of": 2, "contract": "review_note"}
      ],
      "pick": "owner",
      "slots": {"a": [1, 4], "b": [2, 3]}
    },
    "redteam": {
      "description": "One agent builds, a second attacks it to find the weak spots, the builder fixes them, and a checker confirms the fixes.",
      "stages": [
        {"n": 1, "agent": "claude",  "role": "build",  "input": "task",    "contract": "deliverable"},
        {"n": 2, "agent": "chatgpt", "role": "attack", "input": "stage:1", "attack_of": 1, "contract": "attack_list"},
        {"n": 3, "agent": "claude",  "role": "revise", "revise_of": 1, "against": 2, "contract": "revision"}
      ],
      "checker": "chatgpt",
      "slots": {"build": [1, 3], "attack": [2], "check": ["checker"]}
    },
    "vote": {
      "description": "Three agents answer the same short question on their own; the majority wins, and a tie comes to you.",
      "stages": [
        {"n": 1, "agent": "claude",  "role": "vote", "input": "task", "contract": "vote"},
        {"n": 2, "agent": "chatgpt", "role": "vote", "input": "task", "contract": "vote"},
        {"n": 3, "agent": "grok",    "role": "vote", "input": "task", "contract": "vote"}
      ],
      "pick": "tally",
      "slots": {"a": [1], "b": [2], "c": [3]}
    }
  }
}
